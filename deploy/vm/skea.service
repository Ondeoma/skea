# /etc/systemd/system/skea.service
[Unit]
Description=skea application
After=network-online.target
Wants=network-online.target

[Service]
User=skea
Group=skea
EnvironmentFile=/etc/skea/skea.env
ExecStart=/usr/bin/java -Xms512m -Xmx1g -cp '/opt/skea/current/lib/*' skea.app.Main
# 停止時は処理中のリクエストを少し待ってから終わる（他ノードがそのまま受ける）
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
